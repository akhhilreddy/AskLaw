# Copy this file outside version control and replace every placeholder.
COMPOSE_PROJECT_NAME=asklaw-production
ASKLAW_IMAGE_TAG=deployment

# Caddy uses HTTP locally. Supply real hostnames without an http:// prefix in
# production so Caddy provisions HTTPS automatically after DNS is configured.
APP_SITE_ADDRESS=http://localhost
API_SITE_ADDRESS=http://api.localhost
VITE_API_BASE_URL=http://api.localhost
CORS_ORIGINS=http://localhost

SECRET_KEY=replace-with-a-long-random-secret
GEMINI_API_KEY=
GROQ_API_KEY=replace-with-production-groq-key
RESEND_API_KEY=replace-with-production-resend-key
EMAIL_FROM=AskLAW <auth@your-verified-domain.example>
EMAIL_OTP_SECRET=replace-with-a-separate-long-random-secret
FRONTEND_URL=https://your-asklaw-frontend.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-asklaw-api.example/auth/google/callback
SEARXNG_SECRET=replace-with-generated-searxng-secret

COOKIE_SECURE=true
ALLOW_LEGACY_UNTYPED_REFRESH_TOKENS=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
GOOGLE_OAUTH_STATE_EXPIRE_MINUTES=10
GOOGLE_OAUTH_EXCHANGE_EXPIRE_MINUTES=2
MONGODB_DATABASE=asklaw
EMBEDDING_PROVIDER=gemini
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=asklaw_documents_gemini
GEMINI_EMBEDDING_BATCH_SIZE=32
MAX_DOCUMENT_UPLOAD_BYTES=20971520
MAX_DOCUMENT_PAGES=500
MAX_DOCUMENT_TEXT_BYTES=5242880
