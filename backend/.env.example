APP_NAME=AskLaw API
APP_ENV=development
API_VERSION=1.0.0
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Temporary migration switch. Disable after all legacy refresh cookies expire.
ALLOW_LEGACY_UNTYPED_REFRESH_TOKENS=true
GEMINI_API_KEY=
GROQ_API_KEY=
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=asklaw
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=asklaw_documents_gemini
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_EMBEDDING_BATCH_SIZE=32
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
MAX_DOCUMENT_UPLOAD_BYTES=20971520
MAX_DOCUMENT_PAGES=500
MAX_DOCUMENT_TEXT_BYTES=5242880
SEARXNG_URL=http://127.0.0.1:8080/search
MCP_HOST=127.0.0.1
MCP_PORT=8001
